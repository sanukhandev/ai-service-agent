# Local POC only. Copy to .env and supply secrets on your machine.
# Never commit .env or credentials.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost
NGINX_PORT=80
# Nginx is intentionally fixed to host port 80 for the local POC.

# PostgreSQL and Redis (internal Docker DNS)
POSTGRES_DB=ai_service_agent
POSTGRES_USER=postgres
# Migration-owner secret: only the PostgreSQL container needs it.
POSTGRES_PASSWORD=
# A DIFFERENT password for the least-privileged agent_runtime Node role.
POSTGRES_APP_PASSWORD=
REDIS_URL=redis://redis:6379

# Node/Fastify is the only application backend.
API_HOST=0.0.0.0
API_PORT=4000
# Runtime DB connection uses PGHOST/PGDATABASE/PGUSER/PGPASSWORD,
# supplied by Compose with agent_runtime; do not use postgres as Node's user.
# Foundry project endpoint is NOT a direct Azure OpenAI inference endpoint.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=anfz-sara01-agent
FOUNDRY_AGENT_VERSION=
# Required by the P3 migrate/seed service. Use an existing published Sara version.
# Never change an already-pinned version implicitly; publish and migrate intentionally.
AZURE_CONFIG_DIR=/home/app/.azure

# n8n remains private. Configure integration secrets when P4 is implemented.
N8N_BASE_URL=http://n8n:5678
# Required by scripts/seed-n8n-anzfc.mjs: persistent random value, >=32 chars.
N8N_ENCRYPTION_KEY=
# n8n owner credentials are runtime-only and deliberately NOT stored in this file.
# See infra/n8n/ancfz/SEEDING.md for initial owner + project import.
# ANCFZ MockGateway demo Orders: X-Guest-ID is configuration, not authorization.
# Configure X-API-Key separately as a private n8n HTTP Header Auth credential.
MOCKGATEWAY_GUEST_ID=
# n8n's credential for X-API-Key must never be committed to .env.example.

# Optional P5 services
AZURE_STORAGE_ACCOUNT_URL=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# P4 authorized Salesforce lead dispatch. Off unless explicitly enabled.
# Must equal the private n8n 'X-ANCFZ-Workflow-Key' Header Auth credential.
ANCFZ_LEAD_DISPATCH_ENABLED=false
ANCFZ_N8N_WEBHOOK_SECRET=
