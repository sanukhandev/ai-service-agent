# Gemini experimental stack only. Copy into this worktree's private .env.
# Do not reuse the Foundry main stack's .env, n8n encryption key or database secrets.
# Never commit .env or credentials.
# Ensure Compose never shares the Foundry main project even if both stacks are started.
COMPOSE_PROJECT_NAME=ai-service-agent-gemini

# Isolated Gemini Developer API experiment (do not commit populated .env).
GEMINI_API_KEY=
# Generate a 32-byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GEMINI_STATE_ENCRYPTION_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
# Operator-only knowledge ingestion: use the same supported File Search model.
GEMINI_FILE_SEARCH_MODEL=gemini-3.8-flash
# Private originals retained for independent source verification. Create locally.
AGENT_KNOWLEDGE_ORIGINALS_ROOT=./private/gemini-originals
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:2000
# Experiment ingress: 127.0.0.1:2000 -> nginx:80 (fixed in docker-compose.yml).
# Foundry main may continue using localhost:80 independently.

# PostgreSQL and Redis (internal Docker DNS)
POSTGRES_DB=ai_service_agent_gemini
POSTGRES_USER=postgres
# Migration-owner secret: only the PostgreSQL container needs it.
POSTGRES_PASSWORD=
# A DIFFERENT password for the least-privileged agent_runtime Node role.
POSTGRES_APP_PASSWORD=
REDIS_URL=redis://redis:6379

# Node/Fastify is the only application backend.
API_HOST=0.0.0.0
API_PORT=4000
# Runtime DB connection uses PGHOST/PGDATABASE/PGUSER/PGPASSWORD,
# supplied by Compose with agent_runtime; do not use postgres as Node's user.
# Published agent versions stay pinned; changing this default only affects new seeds.

# n8n remains private in the Gemini Compose project; do not reuse the main n8n owner/key/data.
# Configure separate integration secrets when needed.
N8N_BASE_URL=http://n8n:5678
# Required by scripts/seed-n8n-anzfc.mjs: persistent random value, >=32 chars.
N8N_ENCRYPTION_KEY=
# n8n owner credentials are runtime-only and deliberately NOT stored in this file.
# See infra/n8n/ancfz/SEEDING.md for initial owner + project import.
# Store 2Checkout mock API credentials only in a private n8n credential vault.

# Image-only PDF OCR is not enabled in this POC. Approve a separate provider and
# normalized text before indexing scanned PDFs as business knowledge.

# P4 authorized Salesforce lead dispatch. Off unless explicitly enabled.
# Must equal the private n8n 'X-ANCFZ-Workflow-Key' Header Auth credential.
ANCFZ_LEAD_DISPATCH_ENABLED=false
ANCFZ_N8N_WEBHOOK_SECRET=

# P4 authenticated ticket-scoped quotation rendering; off by default.
ANCFZ_QUOTE_DISPATCH_ENABLED=false

# Optional ANCFZ 2Checkout mock test journey; NEVER enabled by default.
# Requires private isolated n8n credentials and synthetic identity documents.
ANCFZ_PAYMENT_DISPATCH_ENABLED=false
ANCFZ_TEST_OTP_ENABLED=false
ANCFZ_OTP_MOCK_ENABLED=false
ANCFZ_OTP_PEPPER=
# Separate optional OCR provider for synthetic passport/Emirates ID uploads.
# Disabled without both secrets; not required for the Gemini model or RAG.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Absolute or repo-relative private host directory, mounted read-only into Node.
GEMINI_APPROVED_TEXT_ROOT_HOST=./private/gemini-approved

# Optional, synthetic-only identity OCR alternative when Azure is unavailable.
# NEVER enable this path for real identity documents or public HTTP sessions.
IDENTITY_OCR_PROVIDER=azure
ALLOW_SYNTHETIC_GEMINI_OCR=NO
GEMINI_ID_OCR_MODEL_ID=gemini-3.8-flash
