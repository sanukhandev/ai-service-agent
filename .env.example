# POC local-only defaults. Copy to .env and supply secrets locally.
# Never commit .env or real credentials.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost
NGINX_PORT=80

# PostgreSQL / Redis (Docker DNS addresses)
# POSTGRES_USER is the local migration owner; P2 creates a separate runtime role.
POSTGRES_DB=ai_service_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379

# Node API / Python Model Gateway
API_HOST=0.0.0.0
API_PORT=4000
AI_GATEWAY_URL=http://ai-gateway:8000
AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000
INTERNAL_SERVICE_TOKEN=

# Microsoft Foundry: bind existing, published agent version.
# Project endpoint example:
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=anfz-sara01-agent
FOUNDRY_AGENT_VERSION=
AZURE_CONFIG_DIR=/home/app/.azure

# n8n remains private on Docker network
N8N_ENCRYPTION_KEY=
N8N_BASE_URL=http://n8n:5678

# Optional external services — configure when P5 is implemented
AZURE_STORAGE_ACCOUNT_URL=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
