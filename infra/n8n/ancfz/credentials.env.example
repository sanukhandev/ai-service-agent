# Copy to a PRIVATE location outside the repository before supplying real values.
# Example: ~/.config/ancfz/n8n-credentials.env or %USERPROFILE%\ancfz-n8n-credentials.env
# Never commit the filled file or the generated import file.

# Strong random secret shared ONLY between Node's authorized dispatcher and
# the n8n Webhook Header Auth credential. At least 32 characters.
ANCFZ_N8N_WEBHOOK_SECRET=

# Salesforce client_id and client_secret are NOT taken from this env file.
# They remain "xxxx" in credentials.template.json until changed in n8n's
# credential editor. The generic OAuth2 Client Credentials credential sends
# them to the configured sandbox /services/oauth2/token endpoint.

# n8n SMTP credential for sending Node-issued OTP emails.
ANCFZ_SMTP_HOST=
ANCFZ_SMTP_PORT=587
ANCFZ_SMTP_TLS=starttls
ANCFZ_SMTP_USER=
ANCFZ_SMTP_PASSWORD=

# MockGateway demo Orders API: private X-API-Key credential.
# Do not reuse a key pasted into a public conversation or document; rotate it.
ANCFZ_MOCKGATEWAY_API_KEY=
