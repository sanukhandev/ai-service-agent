    {
      "id": "mock-otp-validate",
      "name": "Validate Mock OTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body ?? {};\nif (b.testOnly !== true || b.deliveryMode !== 'mock_datatable') {\n  throw new Error('Synthetic OTP marker required');\n}\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (b.agentKey !== 'ancfz' || typeof b.ticketId !== 'string' || !uuid.test(b.ticketId)) throw new Error('Invalid ticket scope');\nif (typeof b.email !== 'string' || b.email.length > 254 || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(b.email)) throw new Error('Invalid email');\nif (!b.email.toLowerCase().endsWith('@example.invalid')) throw new Error('Synthetic email required');\nif (typeof b.otp !== 'string' || !/^\\d{6}$/.test(b.otp)) throw new Error('Invalid test OTP');\nconst parts = b.email.trim().toLowerCase().split('@');\nconst emailMasked = parts[0].slice(0, 2) + '***@' + parts[1];\nconst now = new Date();\nreturn [{ json: {\n  ticketId: b.ticketId, emailMasked, otp: b.otp,\n  issuedAt: now.toISOString(),\n  expiresAt: new Date(now.getTime() + 5 * 60 * 1000).toISOString(),\n  status: 'mock_issued'\n}}];"
      }
    },
    {
      "id": "mock-otp-insert",
      "name": "Record OTP in n8n Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
