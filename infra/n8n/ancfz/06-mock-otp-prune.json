{
  "name": "ANCFZ | MOCK OTP Expiry Cleanup (LOCAL ONLY)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "nodes": [
    {
      "id": "mock-otp-schedule",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        210,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "mock-otp-prune-gate",
      "name": "Assert Local Mock Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if ($env.APP_ENV !== 'development' || $env.ANCFZ_OTP_MOCK_ENABLED !== 'true') throw new Error('Mock OTP cleanup disabled outside local test mode');\nreturn [{json:{cutoff:new Date().toISOString()}}];"
      }
    },
    {
      "id": "mock-otp-prune",
      "name": "Delete Expired OTP Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        760,
        320
      ],
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "ANCFZ_POC_OTPS"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "expiresAt",
              "condition": "lte",
              "keyValue": "={{ $json.cutoff }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Assert Local Mock Mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assert Local Mock Mode": {
      "main": [
        [
          {
            "node": "Delete Expired OTP Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
